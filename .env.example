# Hollow Harbor Environment Configuration (Optional)
# A fresh clone runs out-of-the-box with NO .env required (falls back to verified in-memory ledger & seeded testnet).

# NEAR Protocol Configuration
NEAR_NETWORK_ID=testnet
NEAR_NODE_URL=https://rpc.testnet.near.org

# NEP-366 Relayer Service Configuration
PORT=3001
RELAYER_ACCOUNT_ID=hollow-relayer.testnet
# RELAYER_PRIVATE_KEY=ed25519:... (Optional: omitted defaults to sponsored testnet test pool)

# Deployed Smart Contracts
ITEMS_CONTRACT_ID=hollow-items.testnet
MARKET_CONTRACT_ID=hollow-market.testnet

# Client Application
VITE_RELAYER_URL=http://localhost:3001
VITE_EXPLORER_BASE_URL=https://testnet.nearblocks.io

